<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 纯 Compose 界面：窗口主题只负责启动背景与状态栏，
         用系统自带 Material 主题，不再引入 appcompat / Material Components。 -->
    <style name="Theme.HeytapEngineManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/coui_window_bg_light</item>
    </style>
</resources>
